# Telegram Bot Configuration
# Copy this file to .env and fill in your values

# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Get your chat ID from @userinfobot on Telegram
# For groups: use negative number starting with -100
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional: Check interval in minutes (default: 10)
CHECK_INTERVAL_MINUTES=10

# Optional: Daily health check hour in 24h format (default: 9 for 9 AM)
# The bot will send a status message once per day at this hour
HEALTH_CHECK_HOUR=9
